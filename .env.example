# ==============================================================================
# ALPHALENS / FINAX REAL AUTHENTICATION & GATEWAY CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 📧 REAL EMAIL DELIVERY (Gmail SMTP / Google Workspace / SendGrid / Resend)
# ------------------------------------------------------------------------------
# To receive real OTP verification emails on your Gmail/inbox:
# Step 1: In your Google Account, enable 2-Step Verification.
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password (name it "AlphaLens") and paste the 16-char code below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AlphaLens Security <auth@alphalens.io>

# ------------------------------------------------------------------------------
# 2. 📱 REAL INDIAN SMS OTP DELIVERY (Fast2SMS Gateway)
# ------------------------------------------------------------------------------
# To receive real 6-digit SMS OTPs on Indian mobile numbers (+91):
# Sign up at https://www.fast2sms.com (Free credits provided on signup)
# Copy your API authorization key from Dev API section and paste below:
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# 3. 🌐 GLOBAL SMS OTP DELIVERY (Twilio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 4. 🏦 REAL BROKER OAUTH APIS (Zerodha Kite & Upstox Pro)
# ------------------------------------------------------------------------------
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://127.0.0.1:8000/api/broker/zerodha/callback

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://127.0.0.1:8000/api/broker/upstox/callback
